{
  "name": "go-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @go-game/web dev",
    "dev:server": "pnpm --filter @go-game/server dev",
    "build": "pnpm --filter @go-game/shared typecheck && pnpm --filter @go-game/server typecheck && pnpm --filter @go-game/web build",
    "typecheck": "pnpm --filter @go-game/shared typecheck && pnpm --filter @go-game/web exec tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint '**/*.css'",
    "lint:css:fix": "stylelint '**/*.css' --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@trivago/prettier-plugin-sort-imports": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "latest",
    "stylelint": "latest",
    "stylelint-config-standard": "latest",
    "stylelint-order": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
